---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard';
import { getAllProjects } from '../data/projects';

const allProjects = getAllProjects();
---

<BaseLayout
  title="Projects"
  description="A full archive of the things I've designed, built, and shipped."
>
  <section aria-labelledby="archive-heading" class="mx-auto max-w-5xl px-6 pt-24 pb-12 sm:pt-32">
    <p class="eyebrow">Archive</p>
    <h1 id="archive-heading" class="mt-4 text-4xl sm:text-5xl">Projects</h1>
    <p class="mt-5 max-w-2xl leading-relaxed text-pretty text-slate-600 sm:text-lg">
      Everything worth writing down — <span data-numeric>{allProjects.length}</span> projects, with the
      constraints that shaped each one and what actually came out the other side.
    </p>
  </section>

  <section aria-label="Project archive" class="mx-auto max-w-5xl border-t border-navy-950/10 px-6 pt-12 pb-24 sm:pb-32">
    <div class="grid gap-6 lg:grid-cols-2">
      {/*
        Two-column grid, so stagger by column only — `index % 2` resets the
        delay each row. Letting it grow with the raw index would leave the
        last card waiting half a second after it is already on screen.
      */}
      {
        allProjects.map((project, index) => (
          <ProjectCard
            project={project}
            variant="expanded"
            headingLevel={2}
            style={{ '--reveal-delay': `${(index % 2) * 90}ms` }}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

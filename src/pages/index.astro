---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceAccordion from '../components/ExperienceAccordion.astro';
import Hero from '../components/Hero';
import ProjectCard from '../components/ProjectCard';
import { getAllProjects, getFeaturedProjects } from '../data/projects';

const featured = getFeaturedProjects(3);
const allProjects = getAllProjects();
---

{/*
  Single page. The React components render at build time — no `client:*`
  directive, so no runtime JS is shipped for them. The only interactive
  behaviour on the page (accordion, reveals, sticky nav) is vanilla script.
*/}
<BaseLayout>
  <Hero />

  <section aria-labelledby="work-heading" class="mx-auto max-w-5xl px-6 py-24 sm:py-32" id="work">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 id="work-heading" class="text-2xl">Selected work</h2>
      {/*
        Was a link to the `/projects` archive. That route no longer exists,
        so it now points down the page to the accordion holding the same
        content — the single-page equivalent of the same journey.
      */}
      <a
        href="#experience"
        class="font-mono text-xs text-slate-400 underline-offset-4 transition-colors hover:text-accent-400 hover:underline"
      >
        All <span data-numeric>{allProjects.length}</span> roles below ↓
      </a>
    </div>

    {/*
      Cards reveal in sequence rather than as a block. --reveal-delay is
      read by the `.reveal` transition; the cards enter the viewport at
      effectively the same moment, so the delay is what creates the
      left-to-right cascade.
    */}
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((project, index) => (
          <ProjectCard
            project={project}
            variant="concise"
            headingLevel={3}
            style={{ '--reveal-delay': `${index * 90}ms` }}
          />
        ))
      }
    </div>
  </section>

  <section
    aria-labelledby="experience-heading"
    class="mx-auto max-w-5xl border-t border-cream-50/10 px-6 py-24 sm:py-32"
    id="experience"
  >
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 id="experience-heading" class="text-2xl">Experience</h2>
      <p class="font-mono text-xs text-slate-400">Select a role to expand</p>
    </div>

    <div class="mt-12">
      <ExperienceAccordion projects={allProjects} />
    </div>
  </section>
</BaseLayout>

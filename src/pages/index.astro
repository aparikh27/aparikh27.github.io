---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import ProjectCard from '../components/ProjectCard';
import { getFeaturedProjects, projects } from '../data/projects';
import { site } from '../data/site';

const featured = getFeaturedProjects(3);
const archiveCount = projects.length;
---

{/*
  The React components render at build time — no `client:*` directive, so no
  runtime JS is shipped. Add `client:visible` only to a component that actually
  needs interactivity.
*/}
<BaseLayout>
  <Hero />

  <section aria-labelledby="work-heading" class="mx-auto max-w-5xl px-6 py-24 sm:py-32" id="work">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 id="work-heading" class="text-2xl">Selected work</h2>
      <a
        href="/projects"
        class="font-mono text-xs text-slate-600 underline-offset-4 transition-colors hover:text-accent-700 hover:underline"
      >
        All <span data-numeric>{archiveCount}</span> projects →
      </a>
    </div>

    {/*
      Cards reveal in sequence rather than as a block. --reveal-delay is
      read by the `.reveal` transition; the cards enter the viewport at
      effectively the same moment, so the delay is what creates the
      left-to-right cascade.
    */}
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((project, index) => (
          <ProjectCard
            project={project}
            variant="concise"
            headingLevel={3}
            style={{ '--reveal-delay': `${index * 90}ms` }}
          />
        ))
      }
    </div>
  </section>

  <section
    aria-labelledby="experience-heading"
    class="mx-auto max-w-5xl border-t border-navy-950/10 px-6 py-24 sm:py-32"
    id="experience"
  >
    <h2 id="experience-heading" class="text-2xl">Experience</h2>

    <ol class="mt-12">
      {
        site.experience.map((entry) => (
          <li class="grid gap-2 border-t border-navy-950/10 py-8 first:border-t-0 first:pt-0 sm:grid-cols-[11rem_1fr] sm:gap-8">
            <p class="font-mono text-xs text-slate-500">
              <time>{entry.time}</time>
            </p>
            <div>
              <h3 class="text-base">
                {entry.role}
                <span class="text-slate-500"> · </span>
                <span class="text-slate-600">{entry.org}</span>
              </h3>
              <p class="mt-1 font-mono text-[0.6875rem] text-slate-500">{entry.place}</p>
              <p class="mt-3 max-w-2xl leading-relaxed text-pretty text-slate-600">
                {entry.summary}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
